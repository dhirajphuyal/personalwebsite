---
const { title = "Dhiraj Phuyal — Software Engineer", description = "Dhiraj Phuyal is a Software Engineer building reliable software for complex systems." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5f3ee" />
    <link rel="canonical" href={Astro.url} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="site-shell">
      <header class="nav">
        <a class="brand" href="/" aria-label="Dhiraj Phuyal home">DP<span>.</span></a>
        <nav aria-label="Main navigation">
          <a href="/#work">Work</a>
          <a href="/about">About</a>
          <a href="/writing">Writing</a>
          <a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a>
        </nav>
      </header>
      <main>
        <slot />
      </main>
      <footer class="footer">
        <div>
          <span class="eyebrow">LET'S CONNECT</span>
          <p class="footer-line">Have a problem worth solving?</p>
        </div>
        <div class="footer-links">
          <a href="mailto:hello@dhirajphuyal.com.np">Email ↗</a>
          <a href="https://github.com/" target="_blank" rel="noreferrer">GitHub ↗</a>
          <a href="https://www.linkedin.com/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} Dhiraj Phuyal</span>
          <span>Kathmandu, Nepal</span>
        </div>
      </footer>
    </div>
  </body>
</html>

<style is:global>
@import url('https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&display=swap');

:root {
  --paper: #f5f3ee;
  --ink: #151515;
  --muted: #686762;
  --line: #d8d5cd;
  --accent: #315c4c;
  --card: #ece9e1;
  --white: #fffdf8;
}

* { box-sizing: border-box; }
html { scroll-behavior: smooth; }
body {
  margin: 0;
  background: var(--paper);
  color: var(--ink);
  font-family: "Manrope", system-ui, sans-serif;
  line-height: 1.6;
}
a { color: inherit; text-decoration: none; }
a:hover { color: var(--accent); }
.site-shell { max-width: 1240px; margin: 0 auto; padding: 0 28px; }
.nav {
  height: 88px; display: flex; align-items: center; justify-content: space-between;
  border-bottom: 1px solid var(--line);
}
.brand { font-size: 1.2rem; font-weight: 800; letter-spacing: -.06em; }
.brand span { color: var(--accent); }
.nav nav { display: flex; gap: 28px; font-size: .86rem; font-weight: 600; }
.nav nav a { color: var(--muted); }
.nav nav a:hover { color: var(--ink); }

.hero { min-height: 650px; display: grid; align-content: center; padding: 100px 0 120px; }
.eyebrow {
  font: 500 .72rem/1.2 "DM Mono", monospace; letter-spacing: .11em; color: var(--accent);
}
.hero h1 {
  max-width: 920px; margin: 20px 0 28px; font-size: clamp(3.8rem, 8.2vw, 7.6rem);
  line-height: .94; letter-spacing: -.075em; font-weight: 700;
}
.hero h1 em { font-style: normal; color: var(--muted); }
.hero-copy { max-width: 650px; color: var(--muted); font-size: 1.1rem; }
.actions { display: flex; gap: 12px; margin-top: 34px; }
.button {
  display: inline-flex; align-items: center; padding: 12px 18px; border: 1px solid var(--ink);
  font-size: .85rem; font-weight: 700; transition: .2s ease;
}
.button.primary { background: var(--ink); color: var(--paper); }
.button:hover { transform: translateY(-2px); }

.section { padding: 110px 0; border-top: 1px solid var(--line); }
.section-head { display: grid; grid-template-columns: 1fr 3fr; gap: 40px; margin-bottom: 58px; }
.section h2 { margin: 0; font-size: clamp(2rem, 4vw, 4rem); line-height: 1; letter-spacing: -.06em; }
.section-intro { max-width: 650px; color: var(--muted); font-size: 1.05rem; }

.work-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 18px; }
.project {
  min-height: 390px; background: var(--card); padding: 30px; display: flex; flex-direction: column;
  justify-content: space-between; border: 1px solid transparent; transition: .25s ease;
}
.project:hover { border-color: var(--ink); transform: translateY(-4px); }
.project-number { font: .72rem "DM Mono", monospace; color: var(--muted); }
.project h3 { margin: 12px 0; font-size: 2rem; letter-spacing: -.05em; }
.project p { color: var(--muted); max-width: 510px; }
.tags { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 22px; }
.tag { border: 1px solid #c9c5bc; padding: 5px 8px; font: .68rem "DM Mono", monospace; color: var(--muted); }

.timeline { display: grid; gap: 0; }
.role {
  display: grid; grid-template-columns: 180px 1fr; gap: 40px; padding: 30px 0; border-top: 1px solid var(--line);
}
.role:last-child { border-bottom: 1px solid var(--line); }
.role-date { font: .72rem "DM Mono", monospace; color: var(--muted); }
.role h3 { margin: 0 0 4px; font-size: 1.35rem; }
.role-company { color: var(--accent); font-weight: 700; }
.role p { max-width: 700px; color: var(--muted); margin-bottom: 0; }

.stack { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
.stack-item { padding: 22px 12px 22px 0; border-bottom: 1px solid var(--line); font-size: .9rem; }
.stack-item span { display: block; margin-top: 5px; color: var(--muted); font: .68rem "DM Mono", monospace; }

.callout {
  padding: 80px 0; display: grid; grid-template-columns: 1fr 2fr; gap: 40px; align-items: center;
}
.callout h2 { margin: 0; font-size: clamp(2.4rem, 5vw, 5rem); line-height: .95; letter-spacing: -.06em; }
.callout p { color: var(--muted); max-width: 600px; }

.footer { padding: 90px 0 30px; border-top: 1px solid var(--line); }
.footer-line { font-size: clamp(2rem, 4vw, 4rem); letter-spacing: -.06em; margin: 16px 0 50px; }
.footer-links { display: flex; gap: 24px; font-weight: 700; }
.footer-bottom { display: flex; justify-content: space-between; margin-top: 90px; padding-top: 18px; border-top: 1px solid var(--line); color: var(--muted); font: .68rem "DM Mono", monospace; }

.page { padding: 100px 0 130px; max-width: 920px; }
.page h1 { font-size: clamp(3rem, 7vw, 6.5rem); line-height: .95; letter-spacing: -.07em; margin: 16px 0 36px; }
.page .lead { font-size: 1.25rem; color: var(--muted); max-width: 760px; }
.prose { margin-top: 70px; max-width: 720px; }
.prose h2 { margin-top: 58px; font-size: 1.7rem; letter-spacing: -.04em; }
.prose p, .prose li { color: var(--muted); }
.prose li { margin: 8px 0; }

@media (max-width: 760px) {
  .site-shell { padding: 0 18px; }
  .nav { height: 72px; }
  .nav nav { gap: 14px; font-size: .75rem; }
  .nav nav a:nth-child(3) { display: none; }
  .hero { min-height: auto; padding: 90px 0 100px; }
  .hero h1 { font-size: clamp(3.4rem, 16vw, 5.5rem); }
  .section { padding: 78px 0; }
  .section-head { grid-template-columns: 1fr; gap: 22px; margin-bottom: 38px; }
  .work-grid { grid-template-columns: 1fr; }
  .project { min-height: 330px; }
  .role { grid-template-columns: 1fr; gap: 10px; }
  .stack { grid-template-columns: repeat(2, 1fr); }
  .callout { grid-template-columns: 1fr; padding: 70px 0; }
  .footer-links { flex-wrap: wrap; }
  .footer-bottom { margin-top: 65px; gap: 10px; }
}
</style>
